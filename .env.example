# Environment variables for Medical Shop (Medicare SaaS)
# Copy this to .env for local development (never commit .env)
# On Railway, set these in the Environment Variables dashboard

# ─── Django Core ───────────────────────────────────────────────────────────────
# Generate a new secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secure-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts
# On Railway, add your Railway domain e.g.: youapp.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1,yourapp.up.railway.app

# Add your Railway domain prefixed with https://
CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app

# ─── Database ──────────────────────────────────────────────────────────────────
# Railway sets this automatically when PostgreSQL plugin is added
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/medical_saas_prod

# ─── Redis / Celery ────────────────────────────────────────────────────────────
# Railway sets this automatically when Redis plugin is added
# Format: redis://HOST:PORT/DB
REDIS_URL=redis://localhost:6379/0
